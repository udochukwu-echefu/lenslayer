# Copy to mobile/.env.local (git-ignored) and restart `npm start`.
# EXPO_PUBLIC_* values are bundled into the app: never put secrets here.

# FastAPI origin, without /api/v1.
#   iOS Simulator / web preview: http://127.0.0.1:8000
#   Android emulator:            http://10.0.2.2:8000
#   Expo Go on your own phone:   http://<your-computer's-LAN-IP>:8000
#     (start the API with --host 0.0.0.0 so the phone can reach it)
EXPO_PUBLIC_LENSLAYER_API_URL=http://127.0.0.1:8000

# Web workspace, used to build share and invitation links.
EXPO_PUBLIC_LENSLAYER_WEB_URL=http://localhost:3000

# "local" uses the backend's development identity (LENSLAYER_PLATFORM_AUTH_MODE=local).
# It is ignored in release builds. Use "oidc" for Auth0.
EXPO_PUBLIC_LENSLAYER_AUTH_MODE=local

# Auth0: a *Native* application (no client secret), with these allowed callback
# and logout URLs: lenslayer://auth and, for Expo Go, the exp://…/--/auth URL Expo prints.
EXPO_PUBLIC_AUTH_OIDC_ISSUER=https://YOUR_TENANT.auth0.com
EXPO_PUBLIC_AUTH_OIDC_CLIENT_ID=
EXPO_PUBLIC_AUTH_OIDC_AUDIENCE=https://api.lenslayer.example
