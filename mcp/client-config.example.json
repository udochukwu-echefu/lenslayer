{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "lenslayer": {
        "type": "local",
        "command": ["/absolute/path/to/node", "/absolute/path/to/lenslayer/mcp/dist/stdio.js"],
        "environment": {
          "LENSLAYER_API_URL": "{env:LENSLAYER_API_URL}",
          "LENSLAYER_AGENT_TOKEN": "{env:LENSLAYER_AGENT_TOKEN}"
        },
        "protocol": "legacy",
        "codemode": false,
        "disabled": false,
        "timeout": { "startup": 30000, "catalog": 30000, "execution": 50000 }
      }
    }
  }
}
