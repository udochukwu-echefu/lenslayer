{
  "name": "@lenslayer/agent-sdk",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Server-side client for LensLayer's bounded external-agent API",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/udochukwu-echefu/lenslayer.git",
    "directory": "sdk"
  },
  "bugs": { "url": "https://github.com/udochukwu-echefu/lenslayer/issues" },
  "homepage": "https://github.com/udochukwu-echefu/lenslayer",
  "type": "module",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist/index.js", "dist/index.d.ts", "dist/client.js", "dist/client.d.ts", "dist/transport.js", "dist/transport.d.ts", "dist/types.js", "dist/types.d.ts", "dist/errors.js", "dist/errors.d.ts", "dist/events.js", "dist/events.d.ts", "dist/polling.js", "dist/polling.d.ts", "LICENSE", "CHANGELOG.md"],
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "engines": { "node": ">=20.3.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "node scripts/release-intent.mjs && npm run release:check",
    "release:check": "npm test && node tests/package-check.mjs"
  },
  "devDependencies": { "sigstore": "4.1.1", "typescript": "5.9.3" }
}
