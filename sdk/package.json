{
  "name": "@lenslayer/agent-sdk",
  "version": "0.1.0",
  "license": "UNLICENSED",
  "description": "Server-side client for LensLayer's bounded external-agent API",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/udochukwu-echefu/lenslayer.git",
    "directory": "sdk"
  },
  "bugs": { "url": "https://github.com/udochukwu-echefu/lenslayer/issues" },
  "homepage": "https://github.com/udochukwu-echefu/lenslayer",
  "type": "module",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "LICENSE", "CHANGELOG.md"],
  "engines": { "node": ">=20.3.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run release:check",
    "release:check": "npm test && node tests/package-check.mjs"
  },
  "devDependencies": { "typescript": "5.9.3" }
}
