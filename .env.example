# Existing Streamlit analysis configuration
GROQ_API_KEY=replace-with-a-groq-api-key

# Platform API local defaults. Every variable uses the
# LENSLAYER_PLATFORM_ prefix when loaded by backend/app/config.py.
LENSLAYER_PLATFORM_ENVIRONMENT=local
LENSLAYER_PLATFORM_DATABASE_URL=sqlite:///.lenslayer/platform.db
LENSLAYER_PLATFORM_AUTO_CREATE_SCHEMA=true
LENSLAYER_PLATFORM_AUTH_MODE=local
LENSLAYER_PLATFORM_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LENSLAYER_PLATFORM_OBJECT_STORAGE_BACKEND=local
LENSLAYER_PLATFORM_OBJECT_STORAGE_ROOT=.lenslayer/platform-files
LENSLAYER_PLATFORM_INTAKE_EMAIL_DOMAIN=intake.lenslayer.local
LENSLAYER_PLATFORM_MALWARE_SCAN_BACKEND=signature
LENSLAYER_PLATFORM_CLAMD_HOST=127.0.0.1
LENSLAYER_PLATFORM_CLAMD_PORT=3310
LENSLAYER_PLATFORM_MALWARE_SCAN_TIMEOUT_SECONDS=10

# Production OIDC example
# LENSLAYER_PLATFORM_ENVIRONMENT=production
# LENSLAYER_PLATFORM_AUTO_CREATE_SCHEMA=false
# LENSLAYER_PLATFORM_DATABASE_URL=postgresql+psycopg://user:password@host/lenslayer
# LENSLAYER_PLATFORM_AUTH_MODE=oidc
# LENSLAYER_PLATFORM_OIDC_ISSUER=https://identity.example.com/
# LENSLAYER_PLATFORM_OIDC_AUDIENCE=https://api.lenslayer.example
# LENSLAYER_PLATFORM_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# LENSLAYER_PLATFORM_MALWARE_SCAN_BACKEND=clamd

# Cloudflare R2 or another private S3-compatible object store is required in production
# LENSLAYER_PLATFORM_OBJECT_STORAGE_BACKEND=s3
# LENSLAYER_PLATFORM_S3_BUCKET=lenslayer-documents
# LENSLAYER_PLATFORM_S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
# LENSLAYER_PLATFORM_S3_REGION=auto
# LENSLAYER_PLATFORM_S3_ACCESS_KEY_ID=replace-me
# LENSLAYER_PLATFORM_S3_SECRET_ACCESS_KEY=replace-me
