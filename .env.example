# Existing Streamlit analysis configuration
GROQ_API_KEY=replace-with-a-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=8192

# Platform API local defaults. Every variable uses the
# LENSLAYER_PLATFORM_ prefix when loaded by backend/app/config.py.
LENSLAYER_PLATFORM_ENVIRONMENT=local
LENSLAYER_PLATFORM_DATABASE_URL=sqlite:///.lenslayer/platform.db
LENSLAYER_PLATFORM_AUTO_CREATE_SCHEMA=true
LENSLAYER_PLATFORM_AUTH_MODE=local
LENSLAYER_PLATFORM_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LENSLAYER_PLATFORM_OBJECT_STORAGE_BACKEND=local
LENSLAYER_PLATFORM_OBJECT_STORAGE_ROOT=.lenslayer/platform-files
LENSLAYER_PLATFORM_INTAKE_EMAIL_DOMAIN=intake.lenslayer.local
LENSLAYER_PLATFORM_MALWARE_SCAN_BACKEND=signature
LENSLAYER_PLATFORM_MALWARE_SCAN_TIMEOUT_SECONDS=10
LENSLAYER_PLATFORM_EMAIL_BACKEND=disabled
LENSLAYER_PLATFORM_DASHBOARD_URL=http://localhost:3000

# Production Auth0 OIDC example
# LENSLAYER_PLATFORM_ENVIRONMENT=production
# LENSLAYER_PLATFORM_AUTO_CREATE_SCHEMA=false
# LENSLAYER_PLATFORM_DATABASE_URL=postgresql+psycopg://user:password@host/lenslayer
# LENSLAYER_PLATFORM_AUTH_MODE=oidc
# LENSLAYER_PLATFORM_OIDC_ISSUER=https://YOUR_TENANT.auth0.com/
# LENSLAYER_PLATFORM_OIDC_AUDIENCE=https://api.lenslayer.example
# LENSLAYER_PLATFORM_OIDC_JWKS_URL=https://YOUR_TENANT.auth0.com/.well-known/jwks.json
# LENSLAYER_PLATFORM_OIDC_EMAIL_CLAIM=https://lenslayer.app/email
# LENSLAYER_PLATFORM_OIDC_NAME_CLAIM=https://lenslayer.app/name
# LENSLAYER_PLATFORM_OIDC_EMAIL_VERIFIED_CLAIM=https://lenslayer.app/email_verified
# LENSLAYER_PLATFORM_OIDC_REQUIRE_VERIFIED_EMAIL=true
# LENSLAYER_PLATFORM_MALWARE_SCAN_BACKEND=cloudmersive
# LENSLAYER_PLATFORM_CLOUDMERSIVE_API_KEY=store-in-google-secret-manager
# LENSLAYER_PLATFORM_EMAIL_BACKEND=resend
# LENSLAYER_PLATFORM_RESEND_API_KEY=store-in-google-secret-manager
# LENSLAYER_PLATFORM_RESEND_FROM_EMAIL=LensLayer <notifications@your-verified-domain.example>
# LENSLAYER_PLATFORM_DASHBOARD_URL=https://app.lenslayer.example

# Cloudflare R2 or another private S3-compatible object store is required in production
# LENSLAYER_PLATFORM_OBJECT_STORAGE_BACKEND=s3
# LENSLAYER_PLATFORM_S3_BUCKET=lenslayer-documents
# LENSLAYER_PLATFORM_S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
# LENSLAYER_PLATFORM_S3_REGION=auto
# LENSLAYER_PLATFORM_S3_ACCESS_KEY_ID=store-in-google-secret-manager
# LENSLAYER_PLATFORM_S3_SECRET_ACCESS_KEY=store-in-google-secret-manager

# Bounded agent execution and Calendar OAuth (leave secrets empty until configured).
LENSLAYER_PLATFORM_AGENT_ACTION_LEASE_SECONDS=180
LENSLAYER_PLATFORM_AGENT_ACTION_MAX_ATTEMPTS=3
LENSLAYER_PLATFORM_AGENT_MAX_EVIDENCE_RECEIPTS_PER_RUN=100
LENSLAYER_PLATFORM_WORKER_HEALTH_MAX_AGE_SECONDS=2400
LENSLAYER_PLATFORM_GOOGLE_CALENDAR_CLIENT_ID=
LENSLAYER_PLATFORM_GOOGLE_CALENDAR_CLIENT_SECRET=
# Must exactly match the dashboard origin + /calendar/oauth-return and Google's registration.
LENSLAYER_PLATFORM_GOOGLE_CALENDAR_REDIRECT_URI=
LENSLAYER_PLATFORM_CONNECTOR_ENCRYPTION_KEY=
LENSLAYER_PLATFORM_CONNECTOR_STATE_SIGNING_KEY=

# Hosted bounded agent tasks use the same scoped ledger and human approvals.
LENSLAYER_PLATFORM_HOSTED_AGENTS_ENABLED=true
LENSLAYER_PLATFORM_HOSTED_AGENT_LEASE_SECONDS=180
LENSLAYER_PLATFORM_HOSTED_AGENT_MAX_ATTEMPTS=12
LENSLAYER_PLATFORM_HOSTED_AGENT_WAIT_SECONDS=15
# Optional product model access is separate from OpenCode subscriptions.
LENSLAYER_PLATFORM_HOSTED_MODEL_ENABLED=false
LENSLAYER_PLATFORM_HOSTED_MODEL_API_KEY=
LENSLAYER_PLATFORM_HOSTED_MODEL_TIMEOUT_SECONDS=30
LENSLAYER_PLATFORM_HOSTED_MODEL_MAX_OUTPUT_TOKENS=2048
LENSLAYER_PLATFORM_CONNECTOR_HTTP_TIMEOUT_SECONDS=5
