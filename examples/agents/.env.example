# Only local server-side configuration. Never expose the token in a browser.
LENSLAYER_API_URL=http://127.0.0.1:8000
LENSLAYER_DASHBOARD_URL=http://localhost:3000
LENSLAYER_AGENT_TOKEN=
LENSLAYER_CONTRACT_ID=
LENSLAYER_ASSIGNEE_ID=
# Explicit ISO 8601 instants, including Z or a numeric timezone offset.
LENSLAYER_DUE_AT=
LENSLAYER_DEADLINE_AT=
# Persist these keys. Reuse them and the identical inputs when restarting.
LENSLAYER_RUN_KEY=
LENSLAYER_ACTION_KEY=
# Literal case-insensitive phrase from the retained document, not semantic search.
LENSLAYER_EVIDENCE_QUERY=renew
# Optional; omit to use the latest retained version.
LENSLAYER_VERSION_ID=
# Optional date-arithmetic inputs. Supply both or neither; never guess them.
LENSLAYER_RENEWAL_DATE=
LENSLAYER_NOTICE_DAYS=
LENSLAYER_POLL_TIMEOUT_MS=300000
