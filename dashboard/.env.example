# Server-only FastAPI location. Do not prefix with NEXT_PUBLIC_.
PLATFORM_API_URL=http://127.0.0.1:8000

# Keep the synthetic public workspace enabled for the landing-page demo. Signed-in
# visitors still use their private Auth0-backed workspace.
NEXT_PUBLIC_LENSLAYER_PUBLIC_ACCESS=true

# Public API origin for legacy integrations. Human dashboard requests use the
# same-origin server bridge; bearer tokens stay in the encrypted server session.
# NEXT_PUBLIC_PLATFORM_API_URL=https://lenslayer-api.example.run.app

# Local development identity injected by the Next.js server proxy.
# Production uses an OIDC session and forwards its bearer token instead.
LENSLAYER_LOCAL_USER_ID=local-reviewer
LENSLAYER_LOCAL_USER_EMAIL=reviewer@lenslayer.local
LENSLAYER_LOCAL_USER_NAME=Local Reviewer

# Production Auth0 authentication. Use a Regular Web Application, register
# /api/auth/callback/oidc, and use a high-entropy NextAuth secret.
# NEXTAUTH_URL=https://workspace.lenslayer.example
# NEXTAUTH_SECRET=replace-with-at-least-32-random-bytes
# AUTH_OIDC_NAME=Auth0
# AUTH_OIDC_ISSUER=https://YOUR_TENANT.auth0.com
# AUTH_OIDC_AUDIENCE=https://api.lenslayer.example
# AUTH_OIDC_CLIENT_ID=lenslayer-dashboard
# AUTH_OIDC_CLIENT_SECRET=replace-me
# Server-only database connection name, enabled for this Auth0 application.
# Defaults to Username-Password-Authentication. Passwords stay on Universal Login.
# AUTH_OIDC_EMAIL_CONNECTION=Username-Password-Authentication

# Calendar operations require an independent server-only signing key. Generate
# at least 32 random bytes and configure the exact same value in the backend's
# LENSLAYER_PLATFORM_CALENDAR_SESSION_BINDING_KEY. Never use NEXT_PUBLIC_ here.
# CALENDAR_SESSION_BINDING_KEY=replace-with-a-separate-random-key
