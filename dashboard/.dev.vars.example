NEXTJS_ENV=development
PLATFORM_API_URL=http://127.0.0.1:8000
NEXTAUTH_URL=http://127.0.0.1:8787
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_LENSLAYER_PUBLIC_ACCESS=true

