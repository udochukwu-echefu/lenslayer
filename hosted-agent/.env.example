# Server process only; no browser, OpenCode subscription or fallback credentials.
LENSLAYER_API_URL=http://127.0.0.1:8000
LENSLAYER_AGENT_TOKEN=REPLACE_WITH_SCOPED_SERVER_SECRET
# false by default. Enabling permits a paid product API call; not used in tests.
LENSLAYER_PRODUCT_MODEL_ENABLED=false
LENSLAYER_PRODUCT_MODEL=gpt-6.1-sol
LENSLAYER_PRODUCT_MODEL_API_KEY=REPLACE_WITH_SEPARATE_PRODUCT_API_SECRET
